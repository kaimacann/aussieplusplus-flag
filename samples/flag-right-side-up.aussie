G'DAY MATE!

IMPOHT ME FUNC Length;
IMPOHT ME FUNC CharAt;
IMPOHT ME FUNC Reverse;
IMPOHT ME FUNC InsertChar;

I RECKON alphabet = "abcdefghijklmnopqrstuvwxyz";
I RECKON jumbled = Reverse(alphabet);
I RECKON code = "";
I RECKON kept = 0;

I RECKON p IS A WALKABOUT FROM [0 TO Length(jumbled)) <
    YA RECKON (p + 1) % 3 != 0 ? <
        kept = kept + 1;
        code = code + CharAt(jumbled, p);
        YA RECKON kept % 2 == 0 ? code = code + kept;
    >
>

code = Reverse(code);
code = InsertChar(code, Length(code) / 2, "straya");
GIMME "Flag: " + code;

CHEERS C***!
