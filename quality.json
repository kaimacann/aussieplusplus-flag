{
	"$schema": "./node_modules/@terra-symposium/standards-quality/quality.schema.json",
	"root": ".",
	"sourceRoots": ["aussieplusplus/src"],
	"extensions": [],
	"enabledChecks": {
		"format": false,
		"lint": false,
		"knip": false,
		"dead-code": false,
		"type": false,
		"recommend": false,
		"name": false,
		"alias": false,
		"import": false,
		"forward": false,
		"document": false,
		"security": false
	},
	"qualityCommands": [
		{
			"name": "rust-format-check",
			"command": "cargo",
			"args": ["fmt", "--manifest-path", "aussieplusplus/Cargo.toml", "--", "--check"]
		},
		{
			"name": "rust-clippy",
			"command": "cargo",
			"args": ["clippy", "--manifest-path", "aussieplusplus/Cargo.toml", "--all-targets", "--", "-D", "warnings"]
		},
		{
			"name": "rust-typecheck",
			"command": "cargo",
			"args": ["check", "--manifest-path", "aussieplusplus/Cargo.toml", "--all-targets"]
		},
		{
			"name": "rust-tests",
			"command": "cargo",
			"args": ["test", "--manifest-path", "aussieplusplus/Cargo.toml"]
		},
		{
			"name": "test-right-side-up-example",
			"command": "cargo",
			"args": ["run", "--manifest-path", "aussieplusplus/Cargo.toml", "--bin", "aussie_plus_plus", "--", "flag-right-side-up.aussie"]
		},
		{
			"name": "test-upside-down-example",
			"command": "cargo",
			"args": ["run", "--manifest-path", "aussieplusplus/Cargo.toml", "--bin", "aussie_plus_plus", "--", "--upside-down", "flag.aussie"]
		},
		{
			"name": "rust-build",
			"command": "cargo",
			"args": ["build", "--manifest-path", "aussieplusplus/Cargo.toml", "--all-targets"]
		},
		{
			"name": "rust-doc-build",
			"command": "cargo",
			"args": ["doc", "--manifest-path", "aussieplusplus/Cargo.toml", "--no-deps"]
		},
		{
			"name": "git-diff-check",
			"command": "git",
			"args": ["diff", "--check", "HEAD"]
		}
	]
}
